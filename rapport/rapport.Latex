\section{Travaux liés}
\label{sec:travaux}
% =====================================================================
\begin{table}[htbp]
  \centering
  \caption{Travaux liés}
  \label{tab:travaux}
  \small
  \begin{tabular}{@{}P{2.4cm} P{2.8cm} P{2.8cm} P{3.4cm} P{3.8cm}@{}}
    \toprule
    Travail & Données & Méthode & Résultat principal & Différence avec ce travail \\
    \midrule
    Estrella et Hardouvelis, 1991 \cite{lie1} & Taux du Trésor américain (10 ans et 3 mois), 1955--1988 & Régression linéaire et probit sur séries temporelles & La pente prédit significativement l'activité ($R^2 \approx 0{,}35$) et réagit aux resserrements & Étudie l'impact de la pente sur le PIB aux États-Unis plutôt que l'effet du taux directeur au Maroc \\
    Diebold et Li, 2006 \cite{lie2} & Rendements zéro-coupon américains mensuels, 1970--2000 & Décomposition dynamique de Nelson-Siegel et autorégression & Le facteur pente présente une forte persistance temporelle (autocorrélation $> 0{,}90$) & Modélise toute la courbe sans isoler l'effet direct du taux directeur sur le marché primaire \\
    \bottomrule
  \end{tabular}
\end{table}

\paragraph{Positionnement.} Notre étude transpose l'analyse économétrique de la pente de la courbe des taux au marché souverain marocain (2018--2026) en évaluant la capacité prédictive hors échantillon du seul taux directeur de Bank Al-Maghrib face à une référence naïve stricte.

% =====================================================================
\section{Jeu de données}
\label{sec:donnees}
% =====================================================================
\begin{itemize}
  \item \textbf{Nom et source :} \textit{Historique des décisions de politique monétaire (Taux directeur)} et \textit{Taux moyens pondérés mensuels des émissions du Trésor (TMP)}, Bank Al-Maghrib \cite{donnees}, \url{https://www.bkam.ma}
  \item \textbf{Date d'extraction :} 26/11/2026
  \item \textbf{Licence ou conditions d'utilisation :} Données publiques officielles diffusées librement par Bank Al-Maghrib ; utilisation académique autorisée.
  \item \textbf{Taille :} 66 observations et 5 variables, de février 2018 à mars 2026, fréquence mensuelle.
  \item \textbf{Unité d'observation :} Une fin de mois calendaire correspondant aux adjudications mensuelles des Bons du Trésor marocains.
  \item \textbf{Variable cible :} \texttt{Pente\_10\_2}, définie par la différence de rendement entre les maturités à 10 ans et à 2 ans : $\text{Pente}_t = \text{Taux}_{10\text{ ans}, t} - \text{Taux}_{2\text{ ans}, t}$.
  \item \textbf{Adéquation :} La période couvre trois régimes monétaires distincts au Maroc (baisse à 1,50\,\% en 2020, resserrement à 3,00\,\% en 2023, assouplissement à 2,25\,\% en 2025--2026), permettant de tester la sensibilité de la courbe aux chocs de taux.
  \item \textbf{Limites :} Sur le marché primaire, le Trésor n'émet pas systématiquement la maturité 10 ans chaque mois (38 absences sur 106 mois), réduisant l'échantillon exploitable à 66 observations.
\end{itemize}

\begin{table}[htbp]
  \centering
  \caption{Dictionnaire des principales variables}
  \label{tab:dictionnaire}
  \small
  \begin{tabular}{@{}l P{5.6cm} l l l c@{}}
    \toprule
    Variable & Description & Type & Unité & Rôle & Manquants (\%) \\
    \midrule
    \texttt{Pente\_10\_2} & Écart $\text{Taux}_{10\text{ ans}} - \text{Taux}_{2\text{ ans}}$ & Numérique & Points de \% & Cible & 0 \\
    \texttt{Taux\_directeur} & Taux directeur de Bank Al-Maghrib en vigueur & Numérique & \% & Explicative & 0 \\
    \texttt{2 ans} & Taux moyen pondéré mensuel des BdT à 2 ans & Numérique & \% & Composante cible & 0 \\
    \texttt{10 ans} & Taux moyen pondéré mensuel des BdT à 10 ans & Numérique & \% & Composante cible & 0 \\
    \texttt{Date} & Date de fin de mois de l'adjudication & Date & AAAA-MM-JJ & Date & 0 \\
    \bottomrule
  \end{tabular}
\end{table}

% =====================================================================
\section{Exploration}
\label{sec:exploration}
% =====================================================================
\paragraph{Statistiques descriptives.} Sur les 66 mois retenus, le taux directeur présente une moyenne de 2,27\,\% (écart-type de 0,52\,\%, minimum 1,50\,\%, maximum 3,00\,\%). Le taux à 2 ans s'établit en moyenne à 2,53\,\% (écart-type 0,60\,\%, min 1,66\,\%, max 3,86\,\%) et le taux à 10 ans à 3,14\,\% (écart-type 0,64\,\%, min 2,29\,\%, max 4,65\,\%). La pente cible (\texttt{Pente\_10\_2}) affiche une moyenne de 0,61 point de pourcentage (écart-type 0,12 point, médiane 0,61 point, minimum 0,23 point, maximum 0,89 point).

\paragraph{Qualité des données.} Aucun doublon de date n'a été détecté. Les 38 mois sans émission simultanée à 10 ans et 2 ans ont été écartés plutôt qu'imputés artificiellement afin de ne pas créer de rendements fictifs. Les valeurs hautes observées au premier trimestre 2023 (taux à 10 ans à 4,65\,\%) correspondent au pic réel d'inflation et de resserrement monétaire et ont donc été conservées.

\insererfigure{fig1_evolution_taux.png}{Évolution du taux directeur de BAM et des taux des Bons du Trésor (2018--2026)}{fig:1}

\noindent\textbf{Lecture de la figure~\ref{fig:1}.} Les taux à 2 ans et 10 ans accompagnent les grands cycles du taux directeur (détente en 2020, hausse marquée en 2022--2023, puis reflux en 2024--2026). Toutefois, la maturité courte (2 ans) réagit plus fortement et plus rapidement aux décisions de Bank Al-Maghrib que la maturité longue (10 ans).

\insererfigure{fig2_evolution_pente.png}{Évolution de la pente de la courbe des taux (10 ans $-$ 2 ans)}{fig:2}

\noindent\textbf{Lecture de la figure~\ref{fig:2}.} La pente de la courbe oscille autour de sa moyenne historique (0,61 point) sans jamais s'inverser. On observe néanmoins une compression prononcée de la pente à partir de fin 2024 et jusqu'en novembre 2025 (0,34 point), traduisant un aplatissement de la courbe malgré la baisse du taux directeur.

% =====================================================================
\section{Préparation}
\label{sec:preparation}
% =====================================================================
\begin{itemize}
  \item \textbf{Nettoyage :} Suppression des en-têtes textuels des fichiers bruts de BAM, conversion des pourcentages virgule en nombres flottants, transformation des dates françaises en fins de mois calendaires et filtrage des mois disposant simultanément des taux à 2 ans et 10 ans (66 observations).
  \item \textbf{Variables créées :} Construction de la variable cible $\texttt{Pente\_10\_2} = \texttt{10 ans} - \texttt{2 ans}$ et alignement causal du taux directeur via une jointure arrière (\texttt{pd.merge\_asof(..., direction="backward")}).
  \item \textbf{Encodage et mise à l'échelle :} Aucun encodage catégoriel n'est requis. Avec une seule variable explicative (\texttt{Taux\_directeur}) en régression linéaire ordinaire, la standardisation ne modifie ni les prédictions ni les métriques et conserve l'interprétation directe du coefficient en points de pourcentage.
\end{itemize}

\paragraph{Prévention des fuites.}
\begin{itemize}
  \item[$\boxtimes$] Transformations ajustées sur l'apprentissage seulement, dans un \texttt{Pipeline}.
  \item[$\boxtimes$] Découpage chronologique, sans mélange (données datées).
  \item[$\boxtimes$] Variables construites avec le passé seulement ; jointure \texttt{backward} garantissant que seule une décision de taux directeur antérieure ou contemporaine à la date $t$ est associée.
  \item[$\boxtimes$] Aucune variable ne contient la cible, même indirectement.
  \item[$\boxtimes$] Jeu de test utilisé une seule fois, à la fin.
\end{itemize}
L'alignement chronologique a été contrôlé en affichant les cinq premières observations d'apprentissage (février à juin 2018) : chaque fin de mois d'adjudication est associée au taux directeur de 2,25\,\% décidé antérieurement par BAM, sans chevauchement entre les périodes d'apprentissage et de test.

% =====================================================================
\section{Algorithme}
\label{sec:algorithme}
% =====================================================================
\paragraph{Choix.} L'algorithme principal retenu est la \textbf{régression linéaire} (n\textsuperscript{o}~1 de l'annexe A de l'énoncé) \cite{support}, accompagnée d'une régression \textbf{Ridge} (n\textsuperscript{o}~2) en comparaison. Ce modèle parcimonieux est adapté à une relation quantitative directe à un seul prédicteur sur un échantillon de taille modeste ($n = 52$ en apprentissage), alors que des algorithmes non linéaires complexes (forêts aléatoires ou gradient boosting) surapprendraient le bruit mensuel.

\paragraph{Principe.} L'algorithme estime une relation affine entre la variable explicative et la cible en minimisant la somme des carrés des résidus sur l'échantillon d'apprentissage via l'implémentation \texttt{LinearRegression} de \texttt{scikit-learn} \cite{sklearn}.

\paragraph{Formule essentielle.}
\begin{equation}
  \hat{y}_i = \beta_0 + \beta_1 x_i
  \label{eq:principale}
\end{equation}
où $\hat{y}_i$ désigne la pente prédite de la courbe des taux au mois $i$ (en points de pourcentage), $x_i$ le niveau du taux directeur de BAM (en \%), $\beta_0$ l'ordonnée à l'origine et $\beta_1$ le coefficient directeur estimé.

\paragraph{Paramètres appris.} L'algorithme estime le couple $(\beta_0, \beta_1)$ par moindres carrés ordinaires : $\hat{\beta}_0 = 0{,}5418$ et $\hat{\beta}_1 = 0{,}0380$.

\begin{table}[htbp]
  \centering
  \caption{Hyperparamètres étudiés}
  \label{tab:hyper}
  \small
  \begin{tabular}{@{}l P{6.4cm} l l@{}}
    \toprule
    Hyperparamètre & Rôle et effet attendu & Valeurs testées & Valeur retenue \\
    \midrule
    \texttt{fit\_intercept} & Estime l'ordonnée à l'origine $\beta_0$ (niveau moyen de pente) & \texttt{True} & \texttt{True} \\
    \texttt{alpha} (Ridge) & Pénalise la norme $L_2$ de $\beta_1$ pour limiter la variance & $\{0{,}01; 0{,}1; 1; 10; 100\}$ & $100$ \\
    \bottomrule
  \end{tabular}
\end{table}

% =====================================================================
\section{Protocole expérimental}
\label{sec:protocole}
% =====================================================================
\begin{table}[htbp]
  \centering
  \caption{Découpage des données}
  \label{tab:decoupage}
  \small
  \begin{tabular}{@{}l l r@{}}
    \toprule
    Ensemble & Période ou proportion & Observations \\
    \midrule
    Apprentissage & Du 28/02/2018 au 31/07/2024 (80\,\%) & 52 \\
    Validation & Validation croisée temporelle (\texttt{TimeSeriesSplit}, 5 plis) & 52 \\
    Test & Du 31/08/2024 au 31/03/2026 (20\,\%) & 14 \\
    \bottomrule
  \end{tabular}
\end{table}

\begin{itemize}
  \item \textbf{Référence naïve :} Prédiction constante égale à la moyenne historique de la pente calculée uniquement sur l'apprentissage ($\bar{y}_{\text{train}} = 0{,}626$ point), étalon naturel pour vérifier si le taux directeur apporte une information prédictive supplémentaire.
  \item \textbf{Validation :} Validation croisée temporelle \texttt{TimeSeriesSplit(n\_splits=5)} sur les 52 mois d'apprentissage, avec 5 configurations testées pour \texttt{Ridge}.
  \item \textbf{Métrique principale :} L'erreur absolue moyenne (\textbf{MAE}, en points de pourcentage), car elle mesure directement l'écart moyen de prévision dans l'unité financière de la pente sans surpondérer les mois atypiques.
  \item \textbf{Métriques secondaires :} La racine de l'erreur quadratique moyenne (\textbf{RMSE}, en points de \%) et le coefficient de détermination ($R^2$).
  \item \textbf{Graine aléatoire :} 42.
\end{itemize}

% =====================================================================
\section{Résultats}
\label{sec:resultats}
% =====================================================================
\begin{table}[htbp]
  \centering
  \caption{Comparaison de la référence naïve et du modèle}
  \label{tab:resultats}
  \small
  \begin{tabular}{@{}l cc cc@{}}
    \toprule
    & \multicolumn{2}{c}{MAE (points de \%)} & \multicolumn{2}{c}{RMSE (points de \%)} \\
    \cmidrule(lr){2-3}\cmidrule(lr){4-5}
    Modèle & Validation & Test & Validation & Test \\
    \midrule
    Référence : moyenne historique & 0,1112 $\pm$ 0,0800 & 0,1002 & 0,1298 $\pm$ 0,0841 & 0,1253 \\
    Régression linéaire (n\textsuperscript{o}~1) & 0,1150 $\pm$ 0,0814 & 0,1051 & 0,1342 $\pm$ 0,0865 & 0,1302 \\
    \bottomrule
  \end{tabular}
\end{table}

\insererfigure{fig4_resultats_test.png}{Prévision de la pente sur la période de test (août 2024 -- mars 2026)}{fig:3}

\paragraph{Lecture des résultats.} Sur le jeu de test (tableau~\ref{tab:resultats}), la régression linéaire obtient une MAE de 0,1051 point (RMSE = 0,1302 ; $R^2 = -1{,}29$), légèrement moins bonne que la référence naïve (MAE = 0,1002 ; RMSE = 0,1253 ; $R^2 = -1{,}12$). Sur la figure~\ref{fig:3}, la prédiction linéaire reste quasi plate autour de 0,63--0,65 point alors que la pente observée décroît sensiblement au cours de l'année 2025.

\paragraph{Analyse des erreurs.} L'erreur maximale survient en novembre 2025 (écart absolu de 0,2894 point), lorsque la pente réelle chute à 0,3380 point (taux à 10 ans à 2,74\,\% contre 2,41\,\% à 2 ans) alors que le modèle prédit 0,6274 point.

\begin{table}[htbp]
  \centering
  \caption{Prédictions sur des observations non utilisées pour l'apprentissage}
  \label{tab:illustration}
  \small
  \begin{tabular}{@{}l l l P{7cm}@{}}
